{
  "name": "Sitevision Utilities",
  "description": "Unofficial Sitevision extension: node properties, login discovery, session parameters, recursive reindexing, and more.",
  "version": "1.2.0.0",
  "manifest_version": 3,
  "minimum_chrome_version": "148",
  "action": {
    "default_popup": "views/popup/popup.html",
    "default_icon": "resources/icons/16.png"
  },
  "options_ui": {
    "page": "views/options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "resources/icons/16.png",
    "32": "resources/icons/32.png",
    "48": "resources/icons/48.png",
    "128": "resources/icons/128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  }
}
