{
  "name": "Sitevision Utilities",
  "description": "Unofficial Sitevision extension to inspect JCR node properties, toggle debug parameters and streamline your development workflow.",
  "version": "1.0.0.0",
  "version_name": "1.0.0.0 pre-release",
  "manifest_version": 3,
  "action": {
    "default_popup": "views/popup/popup.html",
    "default_icon": "resources/icons/16.png"
  },
  "options_ui": {
    "page": "views/options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "resources/icons/16.png",
    "32": "resources/icons/32.png",
    "48": "resources/icons/48.png",
    "128": "resources/icons/128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "gusjoh95@sitevision-utilities-extension",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
