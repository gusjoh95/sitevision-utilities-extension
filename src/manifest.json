{
    "name": "Sitevision utilities",
    "description": "Utilities for Sitevision development/debugging. Largely dependant on enabled REST-API in Sitevision.",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "views/popup/popup.html",
        "default_icon": "resources/images/icons/icon-16.png"
    },
    "options_ui": {
    "page": "views/options/options.html",
    "open_in_tab": false
    },
    "icons": {
        "16": "resources/images/icons/icon-16.png",
        "32": "resources/images/icons/icon-32.png",
        "48": "resources/images/icons/icon-48.png",
        "128": "resources/images/icons/icon-128.png"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ]
}