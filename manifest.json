{
    "name": "SV-utilities",
    "description": "Sitevision utility addon.",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "index.html",
        "default_icon": "resources/images/icons/icon-16.png"
    },
    "icons": {
        "16": "resources/images/icons/icon-16.png",
        "32": "resources/images/icons/icon-32.png",
        "48": "resources/images/icons/icon-48.png",
        "128": "resources/images/icons/icon-128.png"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ]
    // "background": {
    //     "service_worker": "./service_worker/index.js", // Används ej
    //     "type": "module"
    // }
}